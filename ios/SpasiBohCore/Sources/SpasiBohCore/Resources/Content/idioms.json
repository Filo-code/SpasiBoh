[
 {
  "id": "it_boh",
  "language": "it",
  "expression": "boh",
  "pronunciation": "бо",
  "literal": {
   "it": "boh",
   "ru": "«бо»"
  },
  "meaning": {
   "it": "Non lo so, e non ho intenzione di indagare.",
   "ru": "«Не знаю» — и выяснять не собираюсь."
  },
  "equivalent": "не знаю",
  "register": "colloquial",
  "usage": {
   "it": "Risposta completa a una domanda. Da solo, senza altro.",
   "ru": "Полноценный ответ на вопрос. Говорится отдельно, без продолжения."
  },
  "culturalNote": {
   "it": "Dà il nome a questa app: «spasibo» + «boh».",
   "ru": "Именно от него название приложения: «спасибо» + «boh»."
  }
 },
 {
  "id": "it_magari",
  "language": "it",
  "expression": "magari",
  "pronunciation": "магари",
  "literal": {
   "it": "magari",
   "ru": "«магари»"
  },
  "meaning": {
   "it": "Se solo fosse vero — oppure «forse», secondo il tono.",
   "ru": "«Хорошо бы!» — или «может быть», в зависимости от интонации."
  },
  "equivalent": "хоть бы",
  "register": "neutral",
  "usage": {
   "it": "Da solo esprime un desiderio; in una frase significa «forse».",
   "ru": "Отдельно — сильное желание; внутри фразы — «может быть»."
  },
  "culturalNote": null
 },
 {
