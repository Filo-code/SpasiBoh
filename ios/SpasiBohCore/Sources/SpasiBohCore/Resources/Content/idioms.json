  }
 },
 {
  "id": "ru_normalno",
  "language": "ru",
  "expression": "нормально",
  "pronunciation": "narmàl'na",
  "literal": {
   "it": "normalmente",
   "ru": "«нормально»"
  },
  "meaning": {
   "it": "Bene, tutto a posto — non «così così».",
   "ru": "«Хорошо», а не «так себе»."
  },
  "equivalent": "bene",
  "register": "neutral",
  "usage": {
   "it": "Risposta standard a «come va?». Non è tiepida come sembra a un italiano.",
